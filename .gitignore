# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env

# Test caches
.pytest_cache/

# uv: lockfiles ARE committed. This series pins a pre-release SDK, so a
# lockfile is what makes a clone reproducible months later.

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Build
dist/
build/
*.egg-info/

# Diagram render previews (regenerable)
.preview/

# Diagram generator dependencies (npm install restores them)
node_modules/

# Maintainers' question viewer, built on demand by series-standard/tools/build_questions_html.py
.review/

# Claude Code: local settings
.claude/

# Misc
*.bak
*.tmp

# Working notes and source material for the rewrite (not published)
.research/

# poster/: only the rendered sheet is published.
poster/*
!poster/*.svg

# Excalidraw working directories: the editable scenes and their notes. The
# rendered SVG is published one level up, in posts/NN-slug/diagrams/.
posts/*/diagrams/excalidraw/

# Authoring material (series-standard Section 3.1): kept on the author's machine, not published.
# The website reads posts/, code/, series.yaml, the root environment (pyproject.toml, uv.lock)
# and the root reference pages only. assets/ holds the design tokens and the Excalidraw generator.
/plan.md
/CONTRIBUTING.md
/verify/
/tools/
/templates/
/audits/
/assets/
