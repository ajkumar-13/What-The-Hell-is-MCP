# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env

# Test caches
.pytest_cache/

# uv: lockfiles ARE committed. This series pins a pre-release SDK, so a
# lockfile is what makes a clone reproducible months later.

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Build
dist/
build/
*.egg-info/

# Node (if any tooling)
node_modules/

# Misc
*.bak
*.tmp

# Working notes and source material for the rewrite (not published)
.research/

# Diagram assets, the poster, and the Excalidraw generator: kept local, not published.
assets/

# poster/: only the rendered sheet is published.
poster/*
!poster/*.svg

# Excalidraw working directories: the editable scenes and their notes. The
# rendered SVG is published one level up, in posts/NN-slug/diagrams/.
posts/*/diagrams/excalidraw/
