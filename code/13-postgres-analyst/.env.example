# Copy to .env. app.py calls load_dotenv() at import time, so anything here is
# in os.environ before the pools are opened.
#
# Two URLs, two PostgreSQL roles, on purpose. There is no fallback from the
# write URL to the read URL: if you only set DATABASE_URL, this server can only
# read, which is the correct behavior rather than a limitation.

# The read-only role. sql/002-readonly-role.sql creates it with SELECT and
# nothing else, plus default_transaction_read_only, a statement_timeout, and an
# idle_in_transaction_session_timeout.
DATABASE_URL=postgresql://mcp_readonly:readonly_password@localhost:5432/analytics

# The write role. Holds INSERT, UPDATE, and DELETE on the seeded tables, and
# owns the audit table, which the server creates through it at startup. Leave
# this unset for a read-only deployment.
DATABASE_WRITE_URL=postgresql://mcp_writer:writer_password@localhost:5432/analytics

# The outermost write gate. Off unless this is exactly "true". With it off, the
# write pool is never even opened.
ENABLE_WRITES=false

# Recorded on every audit row. Deliberately not named MCP_*: a variable's name
# says which component reads it, and these two are read by the audit trail.
#
# Neither of these is an authenticated identity. Under stdio there is nobody to
# authenticate, because the host launched this process. Post 20 covers what to
# record when there is a real identity available.
AUDIT_SESSION_ID=local-dev
AUDIT_ACTOR=unknown
